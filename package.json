{
  "name": "mcp-forge-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/targets/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w mcp-forge",
    "test": "npm test -w mcp-forge",
    "typecheck": "npm run typecheck -w mcp-forge",
    "forge": "node packages/forge/dist/cli/main.js"
  }
}
